---
/**
 * Work Page: Layer 1
 * Tiered repo showcase: Hero (2) + Shipped (5) + Cooking (2+2 books).
 * SPAR verdict: Curate on site, don't censor on GitHub.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TamilRoot from "../components/TamilRoot.astro";
import { getCollection } from "astro:content";

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work | Naveen Riaz</title>
    <meta
      name="description"
      content="What I build. Papers, open source tools, and books. Honesty over impressiveness."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Work | Naveen Riaz" />
    <meta property="og:description" content="What I build. Papers, open source tools, and books. Honesty over impressiveness." />
    <meta property="og:image" content="https://naveenriaz.com/og-image.png" />
    <meta property="og:url" content="https://naveenriaz.com/work/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
    </style>
  </head>
  <body class="section-work">
    <Header activeNav="work" />

    <main class="container container--narrow">
      <section class="page-hero section">
        <h1>Work</h1>
        <p class="page-subtitle">What I build.</p>
        <p>
          I organise my work in three layers. <br />What my body has shipped.
          What my mind is cooking. What my soul is exploring. <br />Every tool
          here serves one belief: living systems thrive when their decisions
          improve.
        </p>
      </section>

      <!-- Execution: Knots & Beads -->
      <section class="section--tight">
        <p class="knots-badge" style="color: var(--body-color);">SHORT FORM</p>
        <div class="layer-header">
          <span class="glow-dot" style="color: var(--color-gold, #ffd700);"></span>
          <h2>Knots <span class="layer-label">Untangling</span></h2>
        </div>
        <p class="section-hook">
          The tangled friction inside organisations.
        </p>
        <p>
          108 diagnostic patterns that show up in every organisation,
          community, and product. Each knot is named, felt, and
          untied, across Soul, Mind, and Body.
        </p>
        <div class="proof-links">
          <a href="/knots/" class="btn">Browse 108 Knots →</a>
        </div>
      </section>

      <div class="divider"><img src="/logo-h.svg" alt="ஃ" /></div>

      <section class="section--tight">
        <p class="knots-badge" style="color: var(--body-color);">LONG FORM</p>
        <div class="layer-header">
          <span class="glow-dot" style="color: var(--body-color);"></span>
          <h2 style="display: flex; align-items: center; gap: 8px;">Beads <span class="layer-label">Solutions</span></h2>
        </div>
        <p class="section-hook">
          Earned tactical wisdom.
        </p>
        <p>
          The solutions that work now because something else failed first.
        </p>
        <div class="proof-links">
          <a href="/beads/" class="btn">Browse All Beads →</a>
        </div>
      </section>

      <div class="divider"><img src="/logo-h.svg" alt="ஃ" /></div>

      <!-- Body: Shipped -->
      <section class="section--tight">
        <div class="layer-header">
          <span class="glow-dot" style="color: var(--body-color);"></span>
          <h2>Contributions <span class="layer-label">Thriving</span></h2>
        </div>

        <div class="hero-grid">
          <div class="hero-card">
            <h3>SPAR-Kit</h3>
            <p class="work-type">Open Source CLI</p>
            <p>
              Run structured AI debates in your terminal. Multiple personas
              argue, a critic stress-tests, an arbiter synthesises. The friction
              is the feature.
            </p>
            <a
              href="https://github.com/synthanai/spar-kit"
              target="_blank"
              rel="noopener">View on GitHub →</a
            >
          </div>

          <div class="hero-card">
            <h3>Intent of Thought</h3>
            <p class="work-type">Academic Paper</p>
            <p>
              GPS for AI reasoning. A framework where AI declares its thinking
              strategy before generating, the same way a GPS announces your
              route before you drive.
            </p>
            <div class="link-row">
              <a
                href="https://github.com/synthanai/intent-of-thought/blob/main/paper/intent_of_thought.pdf"
                target="_blank"
                rel="noopener">Read the Paper →</a
              >
              <a
                href="https://doi.org/10.5281/zenodo.18836659"
                target="_blank"
                rel="noopener"
                class="link-secondary">Zenodo DOI →</a
              >
            </div>
          </div>
        </div>

        <div class="shipped-grid">
          <a
            href="https://github.com/synthanai/decision-moment-graph"
            target="_blank"
            rel="noopener"
            class="shipped-card"
          >
            <h4>Decision Moment Graph</h4>
            <p>
              Open standard for decision governance. Stop storing chats, store
              decision objects.
            </p>
          </a>

          <a
            href="https://github.com/synthanai/ramp-kit"
            target="_blank"
            rel="noopener"
            class="shipped-card"
          >
            <h4>RAMP-Kit</h4>
            <p>
              Reversible Action Management Protocol. Govern decision velocity
              based on reversibility.
            </p>
          </a>

          <a
            href="https://github.com/synthanai/agentic-kit"
            target="_blank"
            rel="noopener"
            class="shipped-card"
          >
            <h4>Agentic-Kit</h4>
            <p>
              Reusable infrastructure for AI decision systems. Agents need
              infrastructure, not just prompts.
            </p>
          </a>

          <a
            href="https://github.com/synthanai/steal-kit"
            target="_blank"
            rel="noopener"
            class="shipped-card"
          >
            <h4>STEAL-Kit</h4>
            <p>
              Structured intelligence capture. Scan, Translate, Evaluate,
              Abstract, Leverage.
            </p>
          </a>

          <a
            href="https://github.com/synthanai/decision-moment-standard"
            target="_blank"
            rel="noopener"
            class="shipped-card"
          >
            <h4>Decision Moment Standard</h4>
            <p>
              The specification behind DMG. Decision governance as a protocol.
            </p>
          </a>
        </div>

        <div id="the-sovereign-march" style="margin-top: var(--space-xl); padding: var(--space-xl); border: 1px solid rgba(255, 215, 0, 0.3); background: rgba(255, 215, 0, 0.02); border-radius: var(--radius-lg);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-sm);">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="glow-dot" style="color: var(--color-gold, #ffd700);"></span>
              <span class="knots-badge" style="color: var(--color-gold, #ffd700); margin: 0; letter-spacing: 0.15em;">PUBLISHED BOOK · DIMENSION I: SELF</span>
            </div>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-label);">16 TERRITORIES</span>
          </div>

          <h3 style="font-size: 1.8rem; color: var(--text-primary); margin-bottom: var(--space-xs); font-weight: 700;">The Sovereign March</h3>
          <p class="work-type" style="color: var(--color-gold, #ffd700); font-size: 0.9rem; margin-bottom: var(--space-md);">Dimension I: Self · The Internal Architecture of Sovereign Governance</p>
          
          <p style="line-height: 1.7; color: var(--text-secondary); margin-bottom: var(--space-lg);">
            Organisations, products, and leaders decay when they confuse brute control with sovereignty. 
            <em>The Sovereign March</em> lays down the sixteen foundational territories of self-governance: how a living human cultivates internal authority, discipline without violence, and self-command before entering the external arena.
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md); margin-top: var(--space-md); font-size: 0.88rem;">
            <div style="background: rgba(255, 255, 255, 0.03); padding: var(--space-md); border-radius: var(--radius-sm); border-left: 2px solid var(--mind-color);">
              <strong style="display: block; color: var(--mind-color); margin-bottom: 6px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">Part 1: The Map</strong>
              <p style="color: var(--text-muted); margin: 0; line-height: 1.5;">
                1. The Sovereign Self<br />
                2. The Unled Self<br />
                3. Sovereignty Is Not Control<br />
                4. The Divided Self
              </p>
            </div>

            <div style="background: rgba(255, 255, 255, 0.03); padding: var(--space-md); border-radius: var(--radius-sm); border-left: 2px solid var(--soul-color);">
              <strong style="display: block; color: var(--soul-color); margin-bottom: 6px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">Part 2: The Instrument</strong>
              <p style="color: var(--text-muted); margin: 0; line-height: 1.5;">
                5. Soul<br />
                6. Mind<br />
                7. Body
              </p>
            </div>

            <div style="background: rgba(255, 255, 255, 0.03); padding: var(--space-md); border-radius: var(--radius-sm); border-left: 2px solid var(--body-color);">
              <strong style="display: block; color: var(--body-color); margin-bottom: 6px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">Part 3: The Architecture</strong>
              <p style="color: var(--text-muted); margin: 0; line-height: 1.5;">
                8. Movement<br />
                9. Awareness<br />
                10. Reasoning<br />
                11. Contribution<br />
                12. Healing
              </p>
            </div>

            <div style="background: rgba(255, 255, 255, 0.03); padding: var(--space-md); border-radius: var(--radius-sm); border-left: 2px solid var(--color-gold, #ffd700);">
              <strong style="display: block; color: var(--color-gold, #ffd700); margin-bottom: 6px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">Part 4: The Practice</strong>
              <p style="color: var(--text-muted); margin: 0; line-height: 1.5;">
                13. The Sovereign Decision<br />
                14. Boundaries<br />
                15. Discipline Without Violence<br />
                16. The Daily March
              </p>
            </div>
          </div>
        </div>

        <h3 class="subsection-heading" style="margin-top: var(--space-2xl);">Codices & Research Frameworks</h3>
        <div class="shipped-grid">
          <div class="shipped-card">
            <h4>Let's SPAR: Disagree to Agree</h4>
            <p class="work-type" style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 4px;">Dialectic Codex · 33 Chapters</p>
            <p>
              The upstream dialectic foundation. How to argue with yourself productively through structured friction and multi-agent sparring.
            </p>
          </div>

          <div class="shipped-card">
            <h4>Build Your Own Sovereignty</h4>
            <p class="work-type" style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 4px;">IRAIMAI Architecture · 75 Territories</p>
            <p>
              The submerged living architecture scaling sovereignty from the individual soul across teams, systems, and institutional bodies.
            </p>
          </div>

          <div class="shipped-card">
            <h4>PIC Your Profile</h4>
            <p class="work-type" style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 4px;">Codex · Completed</p>
            <p>
              Identity architecture and cognitive profiling: uncovering the calling, origin, and endurance beneath social masks.
            </p>
          </div>

          <div class="shipped-card">
            <h4>21-Rep AI Gym</h4>
            <p class="work-type" style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 4px;">Codex · Completed</p>
            <p>
              Cognitive capability building: structured repetitions for developing genuine AI fluency, negative constraints, and taste.
            </p>
          </div>
        </div>
      </section>

      <div class="divider"><img src="/logo-h.svg" alt="ஃ" /></div>

      <!-- Mind: Research Pipeline -->
      <section class="section--tight">
        <div class="layer-header">
          <span class="glow-dot" style="color: var(--body-color);"></span>
          <h2>Living Research <span class="layer-label">In Motion</span></h2>
        </div>

        <div class="cooking-repos" style="margin-top: var(--space-md);">
          <p class="cooking-label">Open specifications and repositories in motion:</p>
          <ul>
            <li>
              <a
                href="https://github.com/synthanai/intent-of-thought-lifecycle"
                target="_blank"
                rel="noopener">Intent of Thought Lifecycle</a
              > : Extending the IoT paper into a living cognitive protocol
            </li>
            <li>
              <a
                href="https://github.com/synthanai/kural"
                target="_blank"
                rel="noopener">Kural Kit</a
              > : Coupling 1330 Tamil couplets into computational decision moments
            </li>
            <li>
              <a
                href="https://github.com/synthanai/student-kit"
                target="_blank"
                rel="noopener">Student-Kit</a
              > : Open intelligence capture toolkit for autonomous learners
            </li>
          </ul>
        </div>
      </section>



      <!-- Soul: Ideas & Concepts -->
      <section class="section--tight">
        <div class="layer-header">
          <span class="glow-dot" style="color: var(--body-color);"></span>
          <h2>Ideas <span class="layer-label">Igniting</span></h2>
        </div>

        <div class="soul-grid">
          <div class="soul-card">
            <h4>Living Systems</h4>
            <p>
              Organisations are not machines. They breathe, grow, decay. Every
              framework I build starts from this belief.
            </p>
          </div>
          <div class="soul-card">
            <h4>Structured Deliberation</h4>
            <p>
              Thinking is a craft. SPAR, RAMP, DMG: all exist because decisions
              deserve more friction, not less.
            </p>
          </div>
          <div class="soul-card">
            <h4>Tamil Wisdom Bridge</h4>
            <p>
              The Thirukkural is 2000 years old and speaks to modern leadership.
              Bridging ancient wisdom to contemporary practice.
            </p>
          </div>
          <div class="soul-card">
            <h4>AI with Intent</h4>
            <p>
              AI should declare its reasoning before generating. Transparency is
              not a feature, it is a requirement.
            </p>
          </div>
        </div>
      </section>

      <TamilRoot
        tamil="செயல்"
        transliteration="Seyal"
        meaning="Action, work, the doing. Not mere activity, but purposeful creation that leaves a mark."
        kural={`முடிவும் இடையூறும் முற்றியாங்கு எய்தும்\nபடுபயனும் பார்த்துச் செயல்.`}
        kuralNumber={676}
        kuralTranslation="Consider the end, the obstacles, and the benefit before acting."
      />
    </main>

    <Footer />
  </body>
</html>
