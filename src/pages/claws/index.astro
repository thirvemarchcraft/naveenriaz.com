---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';

const allClaws = await getCollection('claws');
const sorted = allClaws
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Page title="Claws" description="Rules that ossified into traps. Legacy constraints and anti-patterns named, gripped, and released." activeNav="claws">
  <section class="claws-hero">
    <div class="container">
      <p class="hero-badge">பற்று (PATRU)</p>
      <h1>
        <span class="title-accent">Claws</span>
      </h1>
      <p class="hero-sub">
        Rules that ossified into traps.<br />
        The grip names what held you. The release names what freed you.
      </p>
      <p class="hero-count">{sorted.length} claws identified</p>
    </div>
  </section>

  <section class="claws-grid container">
    {sorted.map((claw) => {
      const date = claw.data.date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });

      return (
        <a
          href={`/claws/${claw.id}`}
          class="claw-card"
        >
          <div class="claw-card__top">
            <span class="claw-card__badge">🦞 CLAW</span>
            <span class="claw-card__date">{date}</span>
          </div>
          <h3 class="claw-card__title">{claw.data.title}</h3>
          <p class="claw-card__grip">{claw.data.grip}</p>
          {claw.data.born_from_literature && (
            <span class="claw-card__source">Literature grounded</span>
          )}
        </a>
      );
    })}
  </section>
</Page>

<style>
  /* Hero */
  .claws-hero {
    padding: var(--space-3xl) 0 var(--space-xl);
    text-align: center;
  }

  .hero-badge {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--soul-color);
    margin-bottom: var(--space-sm);
  }

  .claws-hero h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    color: var(--text-primary) !important;
    margin-bottom: var(--space-sm);
  }

  .title-accent {
    background: linear-gradient(135deg, #C43D3D, #E8742E, #D4A843);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .hero-count {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    opacity: 0.5;
    margin-top: var(--space-md);
  }

  /* Grid */
  .claws-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
    padding-bottom: var(--space-4xl);
  }

  /* Card */
  .claw-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg) var(--space-xl);
    border-radius: var(--border-radius);
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(196, 61, 61, 0.06), transparent);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .claw-card:hover {
    transform: translateY(-3px);
    border-color: rgba(196, 61, 61, 0.3);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4);
    text-decoration: none;
  }

  .claw-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-sm);
  }

  .claw-card__badge {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soul-color);
  }

  .claw-card__date {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.04em;
  }

  .claw-card__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: var(--space-xs);
  }

  .claw-card__grip {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    font-style: italic;
    line-height: 1.45;
    margin-bottom: var(--space-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .claw-card__source {
    font-family: var(--font-label);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soul-color);
    opacity: 0.5;
    margin-top: auto;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .claws-grid {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .claw-card {
      padding: var(--space-md) var(--space-lg);
    }
  }
</style>
